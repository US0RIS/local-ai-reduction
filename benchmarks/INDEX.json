{
  "policy_version": 10,
  "rules": {
    "promoted_requires_committed_generator": true,
    "superseded_artifacts_may_remain_for_history": true,
    "long_training_artifacts_require_seed_and_evaluation_provenance": true,
    "current_claims_must_name_context_and_baseline": true,
    "quality_representation_must_match_memory_representation": true,
    "compression_calibration_must_be_disjoint_from_final_evaluation": true,
    "multi_seed_and_native_packed_are_independent_evidence_axes": true,
    "full_runtime_gate_requires_weight_and_kv_native_primitives_plus_integrated_measurement": true,
    "real_model_gate_thresholds_must_be_committed_before_observing_results": true,
    "negative_real_model_results_must_not_be_overridden_by_synthetic_success": true,
    "external_competitive_baseline_required_before_new_real_model_compression_claim": true,
    "operator_level_mechanism_success_must_not_be_promoted_as_end_to_end_model_quality": true,
    "cross_operator_quality_gates_must_aggregate_site_normalized_errors_before_cross_site_aggregation": true,
    "packed_failure_must_not_be_attributed_to_quantization_when_the_unquantized_structural_ceiling_already_fails": true
  },
